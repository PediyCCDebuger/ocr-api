#!/bin/bash
# 阿里云 FC 自定义运行时启动脚本
# FC 冷启动时会执行本文件（或你在控制台配置的「启动命令」）。
# 让 uvicorn 监听 0.0.0.0:9000（FC 自定义运行时默认 CAPort=9000）。
set -e
cd "$(dirname "$0")"

# 关键：Custom.Debian10 自带 Python 是 3.7.4，太老，跑不了 fastapi/uvicorn/ddddocr。
# 必须给函数添加官方「Python310/Python39/Python38」公共层，
# 下面这段会自动优先用层里的新版 Python（系统自带 3.7 仅作兜底）。
PYTHON_BIN=python3
for p in /opt/python3.10/bin/python3 /opt/python3.9/bin/python3 /opt/python3.8/bin/python3 \
         /opt/python/3.10/bin/python3 /opt/python/3.9/bin/python3 /opt/python/3.8/bin/python3; do
    if [ -x "$p" ]; then PYTHON_BIN="$p"; break; fi
done
echo "[bootstrap] using python: $($PYTHON_BIN --version 2>&1)"

# 依赖装到可写且空间充足的位置。/code 可写层常偏小，优先 /tmp（函数磁盘）。
DEPS_DIR=/tmp/pydeps
mkdir -p "$DEPS_DIR"
free_kb=$(df -P "$DEPS_DIR" | awk 'NR==2{print $4}')
if [ -n "$free_kb" ] && [ "$free_kb" -lt 300000 ] 2>/dev/null; then
    DEPS_DIR="$(dirname "$0")/pydeps"
    mkdir -p "$DEPS_DIR"
fi
export PYTHONPATH="$DEPS_DIR${PYTHONPATH:+:$PYTHONPATH}"
echo "[bootstrap] deps dir: $DEPS_DIR"

# 云端自动补装依赖（仅在当前实例缺失时执行一次；实例保活期间不会重复安装）
# 使用阿里云国内 PyPI 镜像，避免 files.pythonhosted.org 在阿里云环境下载超时
if ! "$PYTHON_BIN" -c "import ddddocr, fastapi, uvicorn" 2>/dev/null; then
    echo "[bootstrap] installing dependencies..."
    "$PYTHON_BIN" -m pip install -t "$DEPS_DIR" -r requirements.txt --no-cache-dir --quiet \
        -i https://mirrors.aliyun.com/pypi/simple/ --timeout 120
    echo "[bootstrap] dependencies installed"
fi

exec "$PYTHON_BIN" app.py
